APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# 反向代理后取真实 IP/协议：nginx 同机填 127.0.0.1，Cloudflare 等填 *
TRUSTED_PROXIES=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SANCTUM_EXPIRATION=43200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 即时消息网关（GatewayWorker）
QUEUE_CONNECTION=database
GATEWAY_REGISTER_ADDRESS=127.0.0.1:1236
GATEWAY_MODE=direct              # direct=直连 / proxy=nginx 反代（监听 127.0.0.1）
GATEWAY_PORT=1238
GATEWAY_SSL=false                # direct 模式 wss 时置 true
GATEWAY_SSL_CERT=                # 证书路径
GATEWAY_SSL_KEY=
GATEWAY_PUBLIC_WS_URL=                     # 前端连接地址；留空=同源 /ws。直连网关示例：wss://t.test:1238
GATEWAY_PUBLIC_WS_PATH=/ws                 # 留空 GATEWAY_PUBLIC_WS_URL 时使用的同源路径

# 管理后台路径（避免用 admin 等易猜路径；可改为随机串，如 x7k2p9）
ADMIN_PATH=panel

# 即时消息网关（GatewayWorker）
GATEWAY_PUBLIC_WS_URL=
GATEWAY_PUBLIC_WS_PATH=/ws
GATEWAY_PORT=1238
GATEWAY_SSL=false
# GATEWAY_SSL_CERT=
# GATEWAY_SSL_KEY=
